/*
 * optokbd: split wireless keyboard, a Seeed XIAO nRF52840 (board:
 * seeeduino_xiao_ble) in each half. https://github.com/hhiroshell/optokbd
 *
 * Each half has a 4 x 7 matrix (R0-R3 x C0-C6) with 25 keys: 7 columns on
 * R0-R2 and 4 thumb keys on R3 C3-C6. On both halves C0 is the outermost
 * (pinky side) column and C6 the innermost one. Diodes are col2row.
 *
 * The row and column pins differ between the halves, so row-gpios and
 * col-gpios are set in optokbd_left.overlay and optokbd_right.overlay.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include "optokbd-layouts.dtsi"

&physical_layout0 {
    transform = <&matrix_transform0>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    /*
     * Columns 0-6 are the left half (outer to inner) and columns 7-13 the
     * right half (inner to outer), so the keymap reads left to right.
     */
    matrix_transform0: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)   RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)   RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)   RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
                        RC(3,3) RC(3,4) RC(3,5) RC(3,6)   RC(3,7) RC(3,8) RC(3,9) RC(3,10)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
    };
};
